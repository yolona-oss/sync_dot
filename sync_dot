# UTILS
#VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV#

printWW() { # print shorted string by ${2} param
end=${#1}
begin=$(( ${end} - ${2} ))
[ ${begin} -ge 1 ] && echo "..$(cut -c$(( ${begin} + 3 ))-${end} <<< "$1")" || echo "$1"
}

log() { logger -p user.notice "sync_dot: $*"; }

alarm()
{
    for msg in "$@"
    do
        printf '[%s] %s\n' "$(yellow "II")" "$msg"
    done
}

warn()
{
    for msg in "$@"
    do
        printf '[%s] %s\n' "$(red '!!')" "$msg"
    done
}

cleanup()
{
    rm -f "${buff}" "${buff}".?
}

die()
{
    if [[ -z $1 ]]
    then
        warn "Terminating"
    else
        warn "$@" "Terminating"
    fi

    cleanup
    exit 1
}

choose()
{ #continue running program or terminate
    read -p "${1:-Proceed}? [yN] " yn
    if ! [[ $yn =~ ^([yY]|[yY][eE][sS])$ ]]; then
        die
    fi
}

# must hanle by [[ ]] (man test)
yn()
{
    read -p "${1:-Proceed}? [yN] " yn
    if [[ $yn =~ ^([yY]|[yY][eE][sS])$ ]]; then
        echo "y"
    else
        echo ""
    fi
}

success_msg() { printf '[%s] %s\n' "$(green "SS")" "$*"; }

if_success()
{
    #check for flag($1) value and print congrat of warn with $2 and $3.
    #if $2 specified as "die_if_not", then if value is'n satisfactory $flag var
    #the program will be terminated.
    #func takes $4 and $5 arguments which parce as an func or program that
    #will be run according to the value of $flag
    flag=$1
    diecmd=""

    if [[ $2 == "die_if_not" ]]; then
        diecmd="die"
        shift
    fi

    if (( ! $flag )); then
        [[ $2 == "skip" ]] || success_msg "$2"

        [[ -n $4 ]] && $4

        return 0
    else
        [[ $3 == "skip" ]] || warn "$3"

        [[ -n $5 ]] && $5
        [[ -n $diecmd ]] && $diecmd

        return 1
    fi
}

prompt_input()
{
    read -rep "${1-"Type: "}" input
    echo "$input"
}

make_save()
{
    cp "$dotFilesTab" "${dotFilesTab}-$(date '+%d.%m.%Y-%H:%M')" && return 0
}

# watched paths from the table (first column)
table_paths()
{
    awk 'NF {print $1}' "$dotFilesTab"
}

in_table()
{
    table_paths | grep -Fxq -- "$1"
}

#COLORIZING (plain text when not on a terminal, e.g. under incron)
if [[ -t 1 ]] && tput setaf 1 &>/dev/null; then
    _NORMAL=$(tput sgr0)
    red()    { printf '%s%s%s' "$(tput setaf 1)" "$*" "$_NORMAL"; }
    green()  { printf '%s%s%s' "$(tput setaf 2)" "$*" "$_NORMAL"; }
    blue()   { printf '%s%s%s' "$(tput setaf 4)" "$*" "$_NORMAL"; }
    yellow() { printf '%s%s%s' "$(tput setaf 3)" "$*" "$_NORMAL"; }
    cyan()   { printf '%s%s%s' "$(tput setaf 6)" "$*" "$_NORMAL"; }
else
    red()    { printf '%s' "$*"; }
    green()  { printf '%s' "$*"; }
    blue()   { printf '%s' "$*"; }
    yellow() { printf '%s' "$*"; }
    cyan()   { printf '%s' "$*"; }
fi

colorize_path()
{
    base=$(basename "$1")
    dir=$(dirname "$1")
    printf '%s/%s' "$dir" "$(${2:-green} "$base")"
}

#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

startup()
{
    load_config
    if (( ! $UID ))
    then
        die "The program cant run with root privileges"\
            "Please, create new common user or sign in as an existing user"
    fi

    # incron runs us without a terminal: never stop to ask there
    if ! [[ -t 0 ]] && { ! [[ -f "$dotFilesTab" ]] || ! [[ -d "$dotFilesStore" ]]; }
    then
        log "table ($dotFilesTab) or store ($dotFilesStore) missing; run sync_dot in a terminal to set up"
        die "Table or store missing"
    fi

    if ! [[ -f "$dotFilesTab" ]]
    then
        warn "No incron table file"
        choose "Create"
        if [[ $(yn "Proceed manual setup of path") ]]; then
            # no validation :)
            dotFilesTab=$(prompt_input "Select path for table file: ")
            printf ' Dot files tab file path: %s\n' "${dotFilesTab}"
        else
            printf ' Using default path: %s\n' "$dotFilesTab"
        fi

        local dir="$(dirname "$dotFilesTab")"
        printf ' Creating directory: %s for table file\n' "${dir}"
        mkdir -p "${dir}"
        if_success $? die_if_not "Directory for table file created successfully"\
            "Cant create directory"
        touch "$dotFilesTab"
        if_success $? die_if_not "Table file created successfully"\
            "Cant create table file"
    fi

    if ! [[ -d "$dotFilesStore" ]]
    then
        warn "No dotf-store directory"

        if [[ $(yn "Proceed manual setup of path") ]]; then
            # no validation :)
            dotFilesStore=$(prompt_input "Select path for dot store: ")
            printf ' Dot dir path: %s\n' "${dotFilesStore}"
        else
            printf ' Using default path: %s\n' "$dotFilesStore"
        fi

        choose "Creating"
        mkdir -p "$dotFilesStore"
        if_success $? die_if_not "Store directory successfully created"\
            "Cant create store directory"
    fi

    save_config
}

incrontab_reload()
{
    # without -u: installs the table for the current user, no sudo needed
    # (allowed while /etc/incron.allow does not exist or lists the user)
    errmsg=$(incrontab "$dotFilesTab" 2>&1)
    if_success $? "Incrontab successfuly reloaded for user: $(cyan "$USER")"\
        "Some error ocurred while reloading incrontab
        incrontab: $errmsg"

    res=$?

    if [[ "$errmsg" =~ not\ allowed ]]; then
        warn "User: $(cyan "$USER") is not allowed to use incron" \
            "Add the user to /etc/incron.allow:" \
            "    echo $USER | sudo tee -a /etc/incron.allow"
    fi

    if ! systemctl is-active --quiet incrond 2>/dev/null; then
        warn "incrond is not running, nothing will be synced automatically" \
            "    sudo systemctl enable --now incrond"
    fi

    return $res
}

add_entry()
{
    if (( $# == 0 ))
    then
        die "No argument passed"
    fi

    if ! [[ -w "$dotFilesTab" ]]; then
        die "Cant write table: $dotFilesTab"
    fi

    added=0

    add_file() {
        if [[ "$1" == *" "* ]]; then
            warn "Skipping (incron cant watch paths with spaces): $1"
            return
        fi
        if in_table "$1"; then
            printf ' -> Already in table %s\n' "$(colorize_path "$1" cyan)"
            return
        fi

        printf ' -> Adding %s\n' "$(colorize_path "$1")"

        printf '%s %s %s\n' "$1" "$mask" "$hendler" >> "$dotFilesTab"
        if_success $? "skip"\
            "Some error ocurred while adding new entry to incron table" && (( added++ ))
    }

    for target in "$@"
    do
        _file=$(realpath -- "${target}" 2>/dev/null) || die "No such file: $target"
        if [[ -d "$_file" ]]; then
            printf ' -> Adding directory %s\n' "$_file"
            while IFS= read -r -d '' f
            do
                add_file "$f"
            done < <(find "$_file" -type f ! -path '*/.git/*' -print0 | sort -z)
        elif [[ -r "$_file" ]]; then
            add_file "$_file"
        else
            die "No such file: $_file"
        fi
    done

    if (( added > 0 )); then
        incrontab_reload
    fi
}

sync()
{
    if [[ $1 == all ]]; then
        echo "Starting syncing all files in $dotFilesTab"

        mapfile -t files < <(table_paths)
        total=${#files[@]}

        err=0
        for file in "${files[@]}"
        do
            sync "$file" || (( err++ ))
        done

        success=$(( total - err ))
        success_msg "$success of $total files from $dotFilesTab have been synced"
        (( err == 0 )) || warn "$(cyan $err) files were not synced (see: sync_dot health)"

        return 0
    fi

    local file
    file=$(realpath -- "$1" 2>/dev/null)

    if ! [[ -f "$file" ]]
    then
        warn "No such file: $(red "$1")"
        return 1
    fi

    srcDir=$(dirname "$file")

    # removing castom username with static user
    dstDir="${dotFilesStore}${srcDir//\/home\/$USER/\/home\/user}/"

    [[ -d "${dstDir}" ]] || mkdir -p "$dstDir"

    if ! cperr=$(cp -- "$file" "$dstDir" 2>&1); then
        errmsg="Cant sync file: \"$file\"
        $cperr"
        log "$errmsg"
        warn "$errmsg"
        command -v "$notify_send" &>/dev/null && $notify_send -a sync_dot "sync_dot" "$errmsg"
        return 1
    fi

    success_msg "$file Synced"
    return 0
}

migrate()
{
    create_from_file()
    {
        file=$(realpath -- "$1" 2>/dev/null)

        if ! [[ -f $file ]]; then
            die "No such file: $(red "$1")"
        fi

        >"$buff"

        columns=$(tput cols 2>/dev/null || echo 80)
        len=$(( columns - 29 ))

        while read -r path _
        do
            [[ -n $path ]] || continue
            cpath=$(colorize_path "$path")
            entry=$(printWW "$cpath" $len)
            printf ' -> Adding "%s" to incron table\n' "$entry"
            printf '%s %s %s\n' "$path" "$mask" "$hendler" >> "$buff"
        done <"${file}"

        old_lines=$(wc -l < "$dotFilesTab")

        # sort and delete same lines
        cat "$dotFilesTab" "$buff" | sort -u > "${buff}.1"
        mv "${buff}.1" "${buff}"

        new_lines=$(wc -l < "$buff")
        echo "Adding $(( new_lines - old_lines )) entries"
        choose

        make_save
        cat "$buff" > "$dotFilesTab"
        if_success $? "Importing from $(green "$file") successfuly completed"\
            "Cant import from $(red "$file")"

        incrontab_reload
    }

    write_to_file()
    {
        if [[ -z $1 ]]; then
            die "No output file specified"
        fi

        file="$(realpath -- "$1")"

        if [[ -f $file ]]; then
            echo "File: $file exist"
            choose "Rewrite"
        fi

        echo "Writing pathes to $file file"
        table_paths > "$file"

        if_success $? "Wrote $(cyan $(wc -l < "$file")) pathes"\
            "Cant export pathes to $(red "$file")"
    }

    case $1 in
        from)
            create_from_file "$2"
            ;;
        to)
            write_to_file "$2"
            ;;
        *)
            warn "Unknown option for $(cyan "migrate") command: $*"
            ;;
    esac
}

#add sort
formating()
{
    columns_formanting()
    {
        maxlen=$(table_paths | awk '{ if (length($0) > max) max = length($0) } END {print max+0}')

        # path padded to the longest one, then the rest of the entry unchanged
        awk -v max="$maxlen" 'NF {
            path = $1
            $1 = ""
            sub(/^ +/, "")
            printf "%-*s %s\n", max, path, $0
        }' "$dotFilesTab" > "$buff"
        printerr="$?"

        if ! (( $(wc -l < "$buff") == $(table_paths | wc -l) ))
        then
            die "Columns formatting error"
        fi

        #make table save
        make_save

        cat "$buff" > "$dotFilesTab"
        err=$(( $? + printerr ))
        if_success $err "incron table was formatted"\
            "incron table was $(red "NOT") formatted"
    }

    case $1 in
        columns)
            columns_formanting ;;
        *)
            columns_formanting ;;
    esac
}

health()
{
    existence_check()
    {
        echo "Running existence check..."
        i=1
        err=0
        while IFS= read -r line
        do
            path=${line%% *}

            if [[ -n $path ]] && ! [[ -r $path ]]
            then
                (( err++ ))
                warn "Line №$i. No file: \"$path\""
            fi
            (( i++ ))
        done <"$dotFilesTab"

        if_success $err "No bad pathes found"\
            "$(cyan $err) bad files were found" && return 0

        if [[ -t 0 ]] && [[ $(yn "Remove them from the table") ]]; then
            make_save
            while IFS= read -r line
            do
                path=${line%% *}
                [[ -n $path && -r $path ]] && printf '%s\n' "$line"
            done <"$dotFilesTab" > "$buff"

            cat "$buff" > "$dotFilesTab"
            if_success $? "Removed $(cyan $err) missing entries"\
                "Cant update incron table" && incrontab_reload
        fi
    }

    clones_check()
    {
        sort -u "$dotFilesTab" > "$buff"

        old=$(wc -l < "$dotFilesTab")
        new=$(wc -l < "$buff")
        dubs=$(( old - new ))

        if_success $dubs "No duplicates were found"\
            "$(cyan $dubs) dublicates were found" && return 0

        choose "Remove entry dublicates"

        make_save

        cat "$buff" > "$dotFilesTab"

        if_success $? "incron table updated successfully"\
            "Cant update incron table" && incrontab_reload
    }

    case $1 in
        existence|'')
            existence_check
            ;;
        clones)
            clones_check
            ;;
        *)
            warn "Unknown option for $(cyan "health") command: $*"
            ;;
    esac
}

cleaning()
{
    delete_store()
    {
        alarm "Are you sure want to remove store directory?" "$dotFilesStore"
        choose

        errmsg=$(rm -rf -- "$dotFilesStore" 2>&1)
        if_success $? "Store deleted"\
            "Cant delete store directore
            rm: $errmsg"
    }

    # Only looks at what `sync` creates: <store>/<first dir of a table path>/…
    # (e.g. <store>/home/user, <store>/etc). Anything else in the store
    # (hand-made folders, README, .git) is never touched.
    delete_unused()
    {
        mapfile -t roots < <(table_paths | awk -F/ 'NF > 2 {print $2}' | sort -u)
        if (( ${#roots[@]} == 0 )); then
            alarm "Table is empty, nothing to compare against"
            return 0
        fi

        unused=()
        for root in "${roots[@]}"
        do
            [[ -d "$dotFilesStore/$root" ]] || continue
            while IFS= read -r -d '' file
            do
                #removing /home/user/ with /home/$USER/
                ufile=${file#"$dotFilesStore"}
                ufile=${ufile/#\/home\/user\//\/home\/$USER\/}
                in_table "$ufile" || unused+=("$file")
            done < <(find "$dotFilesStore/$root" -type f ! -path '*/.git/*' -print0)
        done

        if (( ${#unused[@]} == 0 )); then
            success_msg "No unused files in store"
            return 0
        fi

        columns=$(tput cols 2>/dev/null || echo 80)
        len=$(( columns - 5 ))
        for file in "${unused[@]}"
        do
            printf ' -> %s\n' "$(printWW "$(colorize_path "$file" red)" $len)"
        done

        choose "Remove these $(cyan ${#unused[@]}) files"
        rm -f -- "${unused[@]}"
        if_success $? "Removed $(cyan ${#unused[@]}) unused files"\
            "Cant remove some files"
    }

    delete_table_saves()
    {
        tabDir=$(dirname "$dotFilesTab")
        tabName=$(basename "$dotFilesTab")
        saves=( "$tabDir/$tabName"-$save_suffix )
        [[ -e "${saves[0]}" ]] || saves=()

        if (( ${#saves[@]} == 0 ))
        then
            alarm "No save files in: $(printWW "$tabDir" 20)"
            return 0
        fi

        alarm "List of saves:"
        for (( i = 0; i < ${#saves[@]}; i++ ))
        do
            printf '%3s. %s\n' $i "${saves[$i]}"
        done

        choose "Delete all"

        errmsg=$(rm -f -- "${saves[@]}" 2>&1)

        if_success $? "All table save files in $(green "$(printWW "$tabDir" 20)") have been deleted"\
            "Cant delete some save files
            rm: $errmsg"
    }

    case $1 in
        all)
            delete_store
            ;;
        unused)
            delete_unused
            ;;
        saves)
            delete_table_saves
            ;;
        *)
            warn "Unknown option for $(cyan "clean") command: $*"
            ;;
    esac
}

case $command in
    h|help|'')
        usage
        cleanup
        exit 0
        ;;
esac

startup

case $command in
    add|a)
        shift
        add_entry "$@"
        ;;
    sync)
        sync "$arg"
        ;;
    migrate)
        shift
        migrate "$@"
        ;;
    format)
        formating "$arg"
        ;;
    health)
        health "$arg"
        ;;
    clean)
        cleaning "$arg"
        ;;
    set-dotfiles-tab)
        set_dotfiles_tab "$arg"
        ;;
    set-dotfiles-store)
        set_dotfiles_store "$arg"
        ;;
    *)
        die "Unknown option: $*"
        ;;
esac
status=$?

cleanup
exit $status
