#!/usr/bin/env bash
# sync_dot — keep a copy of your config files in a dotfiles store, automatically.
#
# HOW IT WORKS
#   Every tracked file is a line in an incron table. When the file is saved,
#   incrond runs `sync_dot sync <file>`, which copies it into the store,
#   mirroring its full path (/home/<you> becomes /home/user):
#     ~/.config/fish/config.fish → <store>/home/user/.config/fish/config.fish
#     /etc/pacman.conf           → <store>/etc/pacman.conf
#   Committing/pushing the store (a git repo) is up to you.
#
# SETUP
#   sudo systemctl enable --now incrond
#   sync_dot add ~/.config/fish ~/.config/kitty   # files or whole folders
#   sync_dot sync all                             # first full copy
#
# EVERYDAY
#   sync_dot add <file|dir>...   track more files (also installs the table)
#   sync_dot sync all            copy everything now
#   sync_dot health              find tracked files that no longer exist
#   sync_dot clean unused        drop store copies of untracked files
#   sync_dot help                all commands
#
# FILES
#   ~/.config/sync_dot.conf      table and store paths (set-dotfiles-tab/-store)
#   ~/.config/incron/dotfiles    the table, one line per file:
#     /path/to/file  IN_CLOSE_WRITE  /abs/path/to/sync_dot sync $@
#   Errors go to the journal (journalctl -t sync_dot) and a notification.
#
# LIMITS
#   - incron runs commands with a minimal PATH: the handler is an absolute path.
#   - paths with spaces cannot be watched (incron table limitation).
#   - new files in a tracked folder are not picked up: `sync_dot add` the folder again.
#   - deleting a file does not delete its copy: use `sync_dot clean unused`.
#
# Dependencies: bash, incron, gawk, coreutils, findutils, util-linux (logger)
# Optional:     libnotify (error notifications)

trap die SIGINT SIGTERM
shopt -s globstar

configDir=${XDG_CONFIG_HOME:="$HOME/.config"}
configFile="$configDir/sync_dot.conf"

dotFilesTab=${dotFilesTab:="$HOME/.config/incron/dotfiles"}
dotFilesStore=${dotFilesStore:="$HOME/data/dotfiles"}

notify_send="notify-send"

save_suffix=[0-3][0-9].[0-1][0-9].[0-9][0-9][0-9][0-9]-[0-2][0-9]:[0-6][0-9]
# IN_CLOSE_WRITE: fires once the writer is done (IN_MODIFY fires mid-write,
# possibly many times per save)
mask="IN_CLOSE_WRITE"
hendler="$(realpath "$0") sync \$@"

buff=$(mktemp)

command="$1"
arg="$2"

save_config()
{
    mkdir -p "$(dirname "$configFile")"
    printf 'dotFilesTab="%s"\ndotFilesStore="%s"\n' "$dotFilesTab" "$dotFilesStore" > "$configFile"
}

load_config()
{
    if [[ ! -f "$configFile" ]]; then
        save_config
    fi
    . "$configFile"
}

set_dotfiles_tab()
{
    dotFilesTab="$(realpath "$1")"
    save_config
}

set_dotfiles_store()
{
    dotFilesStore="$(realpath "$1")"
    save_config
}

# USAGE / HELP
#VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV#

usage() #https://stackoverflow.com/questions/19507902/bash-script-usage-output-formatting
{
    COLUMNS=$(tput cols 2>/dev/null || echo 80)
    # Put here all the options your script accepts
    local options=(
    'add <FILE|DIR>...'
    'sync [all] <FILE>'
    'migrate <to|from> <FILE>'
    'format [columns]'
    'health [existence|clones]'
    'clean <all|unused|saves>'
    'set-dotfiles-tab <FILE>'
    'set-dotfiles-store <DIR>'
    'h, help'
)
# Put here the corresponding descriptions for every option you specified in the array above
local descriptions=(
    "Adding files to incron table. A directory adds every file inside it (recursively, .git skipped). Files already in the table are skipped."
    "Command that runs automaticaly every time the incrond is triggered. With <all> specifier syncing all entries in incron table."
    "Importing or exporting files pathes to/from file. Runs with <to> <from> specifier."
    "Formating incron table. Runs with <columns> specifier aligning all columns."
    "Checking incron table for some errors. Runs with <existence> specifier checking all files pathes for existence and offering to remove missing ones. Runs with <clones> specifier checking for entry dublicates. By default runs <existence> check."
    "Cleaning store directory and table directory. With <all> specifier deletes whole directory. With <unused> only synced files that are no longer in the incron table. With <saves> delete all table saves."
    "Use another incron table file."
    "Use another store directory."
    "Display help.")

# Put here the offset options will get
local options_offset=3
# Put here the offset descriptions will get after the longest option
local descriptions_offset_after_longest_option=5
# Put here the maximum length of descriptions spanning
local maximum_descriptions_length=$COLUMNS

# ---------------------------------
# Up until here is the configuration
# ---------------------------------

echo "Usage: $(basename "$0") [OPTION]"

local max_option_length=1
for (( i = 0; i < ${#options[@]}; i++)); do
    if [[ $max_option_length -lt ${#options[$i]} ]]; then
        max_option_length=${#options[$i]}
    fi
done
local descriptions_new_line_offset=$((${max_option_length} + ${options_offset} + ${descriptions_offset_after_longest_option}))
for (( i = 0; i < ${#options[@]}; i++)); do
    printf -- '%*s' ${options_offset}
    printf -- '%s' "${options[$i]}"
    local current_char_index=$((${options_offset} + ${#options[$i]}))
    local current_description_offset=$((${max_option_length} - ${#options[$i]} + ${descriptions_offset_after_longest_option}))
    printf -- '%*s' ${current_description_offset}
    current_char_index=$((${current_char_index} + ${current_description_offset}))
    local current_description="${descriptions[$i]}"
    IFS=' ' read -r -a description_words <<< "${current_description}"
    for (( j = 0; j < ${#description_words[@]}; j++)); do
        current_char_index=$((${current_char_index} + ${#description_words[$j]} + 1))
        if [[ ${current_char_index} -le ${COLUMNS} ]] && [[ ${current_char_index} -le ${maximum_descriptions_length} ]]; then
            printf -- '%s ' "${description_words[$j]}"
        else
            printf -- '\n'
            printf -- '%*s' ${descriptions_new_line_offset}
            printf -- '%s ' "${description_words[$j]}"
            current_char_index=$((${descriptions_new_line_offset} + ${#description_words[$j]}))
        fi
    done
    printf '\n\n'
done
}

